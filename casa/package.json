{
  "name": "casa",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch --env-file-if-exists=../.env src/server.ts",
    "dev:web": "vite",
    "build": "vite build",
    "importa": "node --env-file-if-exists=../.env src/cli/importa.ts",

# Copiare in .env e compilare. .env non va mai nel repository.

# Rete Docker del reverse proxy a cui si agganciano i servizi (nessuna porta pubblicata)
PROXY_NETWORK=nginx_bridge

# --- Donetick ---
# Stringa casuale di almeno 32 caratteri: openssl rand -hex 32
DONETICK_JWT_SECRET=
# URL pubblico di Donetick, se lo esponete (serve per i link nelle notifiche)
DONETICK_PUBLIC_URL=
# Dopo aver creato gli account di tutte le persone: true
DONETICK_SIGNUP_DISABLED=false
DONETICK_TELEGRAM_TOKEN=
# Token API di Donetick, uno per persona (Impostazioni > API token), con il nome
# della persona in maiuscolo come in meta.persone. Casa li usa per segnare chi ha fatto cosa.
DONETICK_TOKEN_ANNA=
DONETICK_TOKEN_LUCA=

# --- Grocy ---
# Chiave API creata in Grocy (menu utente > Gestisci chiavi API)
GROCY_API_KEY=

# --- Home Assistant (facoltativo) ---
HA_URL=http://homeassistant.local:8123
# Token di lunga durata: profilo utente in Home Assistant > Sicurezza
HA_TOKEN=
# Entità da leggere: lasciare vuote quelle che non avete
HA_PV_POWER_ENTITY=sensor.fusionsolar_power
HA_BATTERY_SOC_ENTITY=sensor.fusionsolar_battery_soc
# Capacità in kWh e riserva minima in %: Casa mostra l'energia usabile sopra la riserva
HA_BATTERY_CAPACITY_KWH=
HA_BATTERY_RESERVE_PCT=
# Forecast.Solar (integrazione di Home Assistant): orario di picco previsto
HA_PEAK_TIME_TODAY_ENTITY=sensor.power_highest_peak_time_today
HA_PEAK_TIME_TOMORROW_ENTITY=sensor.power_highest_peak_time_tomorrow
# Lista delle faccende di ciascuno (integrazione "Lista di cose da fare locale"), con il nome in maiuscolo
HA_TODO_ANNA=todo.faccende_anna
HA_TODO_LUCA=todo.faccende_luca

# --- Casa ---
# Segreto per firmare i cookie di sessione: openssl rand -hex 32
CASA_SECRET=
# false solo per provare senza HTTPS
CASA_COOKIE_SECURE=true
# Hash delle password, generati con: docker compose run --rm casa node src/cli/password.ts
CASA_PASSWORD_ANNA=
CASA_PASSWORD_LUCA=
